{
  "name": "nxtduo",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "nxtduo.com", "custom_domain": true },
    { "pattern": "www.nxtduo.com", "custom_domain": true }
  ]
}
